# .env.production - PRODUCTION ENVIRONMENT CONFIGURATION
# ⚠️ NEVER commit this file to version control
# Copy this to .env and update values before deployment

# Application
APP_NAME="BrembyPro"
APP_ENV=production
APP_KEY=base64:GENERATE_NEW_KEY_HERE
APP_DEBUG=false
APP_URL=https://yourdomain.com

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=error

# Database - CHANGE THESE!
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_db_user
DB_PASSWORD=STRONG_PASSWORD_HERE

# Caching & Sessions
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Redis (Optional - if available)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email Configuration
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# AWS (if using S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Pusher (if using real-time features)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# Payment Gateway Keys - SECURE THESE!
STRIPE_KEY=
STRIPE_SECRET=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
RAVE_PUBLIC_KEY=
RAVE_SECRET_KEY=
COINPAYMENTS_MERCHANT_ID=
COINPAYMENTS_IPN_SECRET=

# API Keys - SECURE THESE!
BINANCE_API_KEY=
BINANCE_API_SECRET=
CRYPTOCOMPARE_API_KEY=
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=

# Security Settings
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

# Application Specific Settings
ENABLE_CRYPTO_TRADING=true
ENABLE_STOCK_TRADING=true
ENABLE_BOT_TRADING=true
ENABLE_COPY_TRADING=true
ENABLE_STAKING=true

# Rate Limiting
THROTTLE_LIMIT=60
THROTTLE_MINUTES=1
