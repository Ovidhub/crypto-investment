# Copy to .env.local for local development. Never commit .env.local.
# Generate real values with: npm run env:generate
AUTH_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@enethi.app
ADMIN_PASSWORD_HASH=replace-with-scrypt-hash

# Required on Vercel. Without it the app runs on an in-memory database that is
# per-instance on serverless, so accounts created by one request are invisible
# to the next. Any Postgres works (Neon, Supabase, RDS); the schema and seed
# rows are created automatically on first query.
# DATABASE_URL (or POSTGRES_URL, POSTGRES_PRISMA_URL, or the PG* components)
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
