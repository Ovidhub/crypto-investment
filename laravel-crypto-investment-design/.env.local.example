# Copy to .env.local for local development. Never commit .env.local.
# Generate real values with: npm run env:generate
AUTH_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@enethi.app
ADMIN_PASSWORD_HASH=replace-with-scrypt-hash

# Optional. When omitted, the app runs in in-memory demo mode.
# Set a real Postgres URL to persist users, trades, waitlist and messages.
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
